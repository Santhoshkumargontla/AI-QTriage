# AI-QTriage Backend Environment Configuration
# Copy this file to backend/.env for local development.

# Server-side Gemini API Configuration (NEVER expose to client/browser/PDF/JSON)
GEMINI_API_KEY=GEMINI
GEMINI_MODEL=gemini-flash-latest

# Roboflow Universe downloads (optional; training/data scripts only — never commit real keys)
# ROBOFLOW_API_KEY=

# MongoDB Database Configuration
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DATABASE=ai_qtriage

# Twilio SOS test mode (optional). Canonical names used by twilio_service.py
TWILIO_ENABLED=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=
# Documented legacy aliases only (ignored when canonical is set):
# TWILIO_PHONE_NUMBER → TWILIO_FROM_NUMBER
# EMERGENCY_CONTACT_PHONE / EMERGENCY_PHONE_NUMBER → TWILIO_TO_NUMBER

# YOLO inference keep-threshold (drops boxes below this score)
# Research-demo default: 0.25  Conservative: 0.30
# Do not set 0.10 unless you accept extra false positives with no labeled-set recall gain.
YOLO_CONF_THRESHOLD=0.25
YOLO_LOW_CONFIDENCE_FLAG=0.40
# Optional class-specific keep thresholds (unset = use YOLO_CONF_THRESHOLD)
# YOLO_CONF_THRESHOLD_CUT=
# YOLO_CONF_THRESHOLD_BRUISE=
# YOLO_CONF_THRESHOLD_WOUND=

# EfficientNet classifier: quality gates withhold blanks. These tune the
# remaining softmax reject (not a substitute for negatives in training).
EFFNET_MIN_CONFIDENCE=0.80
EFFNET_TEMPERATURE=1.5

# CORS for the Next.js UI
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Questionnaire template routing only (not a medical confidence threshold)
# QUESTIONNAIRE_ROUTING_THRESHOLD=0.40

# Optional display timezone for compact SOS timestamps
# SOS_DISPLAY_TIMEZONE=Asia/Kolkata

# Frontend (set in the shell or frontend/.env.local, not this file)
# NEXT_PUBLIC_API_URL=http://localhost:8000

