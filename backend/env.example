# AI-QTriage Backend Server Environment Template

# MongoDB configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=ai_qtriage

# Gemini AI Service (Optional - falls back to deterministic rules if missing)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Server configuration
PORT=8000
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Twilio SOS (optional). Canonical names only in this template.
TWILIO_ENABLED=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=
# Legacy aliases (optional): TWILIO_PHONE_NUMBER, EMERGENCY_CONTACT_PHONE, EMERGENCY_PHONE_NUMBER
